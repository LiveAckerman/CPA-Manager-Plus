#!/bin/sh
# chatgpt2api: FastAPI image API, bound to loopback only (reverse-proxied by cpa-manager).
#
# Reads the per-boot internal auth key from /run/chatgpt2api_internal_key (written
# by the init-auth-key oneshot) and exports it as CHATGPT2API_AUTH_KEY. The export
# is process-local, so `docker exec ... env` never sees the secret.
exec 2>&1

KEY_FILE="${CHATGPT2API_INTERNAL_KEY_FILE:-/run/chatgpt2api_internal_key}"
if [ ! -s "${KEY_FILE}" ]; then
    echo "[chatgpt2api] FATAL: internal key file ${KEY_FILE} missing or empty" >&2
    exit 1
fi
CHATGPT2API_AUTH_KEY="$(cat "${KEY_FILE}")"
export CHATGPT2API_AUTH_KEY

cd /opt/chatgpt2api || exit 1
exec /opt/chatgpt2api/.venv/bin/uvicorn main:app \
    --host "${CHATGPT2API_HOST:-127.0.0.1}" \
    --port "${CHATGPT2API_PORT:-8000}" \
    --no-access-log
